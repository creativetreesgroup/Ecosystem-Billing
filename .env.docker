# ============================================================================
# Contoh .env untuk deployment Docker.
#
# Cara termudah: JANGAN edit manual — jalankan `./install.sh`, semua nilai di
# bawah diisi otomatis (kunci, password, IP). Isi manual hanya bila tak pakai
# installer.
#
# PENTING: nilai TIDAK boleh diberi komentar di baris yang sama (mis.
# `DB_PASSWORD=rahasia   # catatan`) — docker compose & installer ikut membaca
# komentarnya sebagai bagian nilai. Taruh komentar di baris terpisah seperti ini.
#
# Catatan Docker:
#  - DB_HOST/REDIS_HOST/REVERB_HOST memakai NAMA SERVICE compose (db/redis/reverb);
#    di-override lagi oleh docker-compose.yml.
#  - VITE_REVERB_HOST HARUS IP LAN server (mis. 192.168.1.10) karena dipakai
#    BROWSER kasir/pelanggan. localhost = realtime mati.
# ============================================================================

APP_NAME="Creative Trees Billing Game"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# APP_URL: IP LAN server (atau domain bila via reverse-proxy). Diisi installer.
APP_URL=http://192.168.1.10

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_DISPLAY_TIMEZONE=Asia/Jakarta

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# --- Database (service `db`) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=creative_trees_billing
DB_USERNAME=ctb_app
# DB_PASSWORD & DB_ROOT_PASSWORD: diisi acak oleh installer. Isi manual bila perlu.
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# --- Redis (service `redis`) ---
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Reverb (service `reverb`) ---
# REVERB_APP_ID/KEY/SECRET: diisi acak oleh installer.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# app -> reverb (internal, nama service)
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST: IP LAN server (dipakai BROWSER). Diisi installer.
VITE_REVERB_HOST=192.168.1.10
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=ws

# --- Home Assistant (kontrol TV via jaringan). Isi bila memakai HA. ---
HA_BASE_URL=http://192.168.1.10:8123
HA_TOKEN=

# --- MQTT / Mosquitto (opsional, unit Tasmota) ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- WAHA (WhatsApp OTP) — LAN saja, jangan dipapar internet ---
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default

# --- Telegram (notifikasi operasional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web & monitoring (dibaca docker-compose.yml) ---
WEB_PORT=80
GRAFANA_PORT=3000
GRAFANA_USER=admin
# GRAFANA_PASSWORD: diisi acak oleh installer.
GRAFANA_PASSWORD=change_me_grafana
