# ============================================================================
# Contoh .env untuk deployment Docker.
#   cp .env.docker .env   lalu isi nilai yang ditandai <ISI>.
#   php artisan key:generate   (atau: docker compose run --rm app php artisan key:generate)
#
# Catatan penting Docker:
#   - DB_HOST/REDIS_HOST/REVERB_HOST sengaja memakai NAMA SERVICE compose
#     (db, redis, reverb) — itu di-override lagi oleh docker-compose.yml.
#   - VITE_REVERB_HOST HARUS IP LAN server (mis. 192.168.1.10), karena dipakai
#     BROWSER kasir/pelanggan, bukan container. localhost = realtime mati.
# ============================================================================

APP_NAME="Creative Trees Billing Game"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.1.10          # <ISI> IP LAN server (atau domain bila via reverse-proxy)

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_DISPLAY_TIMEZONE=Asia/Jakarta

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# --- Database (service `db`) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=creative_trees_billing
DB_USERNAME=ctb_app
DB_PASSWORD=change_me                 # <ISI> harus sama dengan yang dipakai compose
DB_ROOT_PASSWORD=change_me_root       # <ISI> dipakai container mysql + mysql-exporter

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# --- Redis (service `redis`) ---
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Reverb (service `reverb`) ---
REVERB_APP_ID=                        # <ISI> php artisan reverb:generate atau angka acak
REVERB_APP_KEY=                       # <ISI>
REVERB_APP_SECRET=                    # <ISI>
REVERB_HOST=reverb                    # app -> reverb (internal)
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=192.168.1.10         # <ISI> IP LAN server — dipakai BROWSER
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=ws

# --- Home Assistant (kontrol TV via jaringan) ---
HA_BASE_URL=http://192.168.1.10:8123  # <ISI>
HA_TOKEN=                             # <ISI> token long-lived HA

# --- MQTT / Mosquitto (opsional, unit Tasmota) ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- WAHA (WhatsApp OTP) — LAN saja, jangan dipapar internet ---
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default

# --- Telegram (notifikasi operasional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Boot & monitoring (dibaca docker-compose.yml) ---
APP_SEED_ON_BOOT=false                # true sekali saja saat pertama kali install
WEB_PORT=80
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_grafana    # <ISI>
