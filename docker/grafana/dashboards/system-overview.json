{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["creative-trees"],
  "time": { "from": "now-3h", "to": "now" },
  "timezone": "browser",
  "title": "Creative Trees — System Overview",
  "uid": "ctb-overview",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "Server (Host)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "CPU Terpakai",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 } ] } } },
      "targets": [ { "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "RAM Terpakai",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 } ] } } },
      "targets": [ { "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Disk Terpakai (/)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 90 } ] } } },
      "targets": [ { "expr": "100 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"} * 100)", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [ { "color": "blue", "value": null } ] } } },
      "targets": [ { "expr": "time() - node_boot_time_seconds", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "CPU & RAM (riwayat)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU %", "refId": "A" },
        { "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "RAM %", "refId": "B" }
      ]
    },
    {
      "type": "row",
      "title": "Kontainer",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "CPU per kontainer",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "fillOpacity": 10 } } },
      "targets": [ { "expr": "sum by(name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))", "legendFormat": "{{name}}", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "Memori per kontainer",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } } },
      "targets": [ { "expr": "container_memory_usage_bytes{name!=\"\"}", "legendFormat": "{{name}}", "refId": "A" } ]
    },
    {
      "type": "row",
      "title": "MySQL & Redis",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },
    {
      "type": "stat",
      "title": "MySQL Up",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ] } },
      "targets": [ { "expr": "mysql_up", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "MySQL koneksi & query/s",
      "gridPos": { "h": 8, "w": 10, "x": 4, "y": 24 },
      "targets": [
        { "expr": "mysql_global_status_threads_connected", "legendFormat": "koneksi", "refId": "A" },
        { "expr": "rate(mysql_global_status_queries[5m])", "legendFormat": "query/s", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Redis memori & ops/s",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 24 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "redis_memory_used_bytes", "legendFormat": "memori (bytes)", "refId": "A" },
        { "expr": "rate(redis_commands_processed_total[5m])", "legendFormat": "ops/s", "refId": "B" }
      ]
    }
  ]
}
